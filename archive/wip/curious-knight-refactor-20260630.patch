+#[allow(clippy::too_many_lines)]
+async fn sbc_verify(host: &str) -> Result<()> {
+    println!("==> Verifying {} (Q40 acceptance test)", host);
+    let mut pass = 0usize;
+    let mut fail = 0usize;
+    let mut checks: Vec<(String, bool, String)> = Vec::new();
+
+    // 1. ssh reachability
+    let ssh_ok = ssh_probe(host, "echo ok").as_deref() == Some("ok");
+    checks.push(("ssh reachability".to_string(), ssh_ok, String::new()));
+    if !ssh_ok {
+        println!("FAIL: ssh reachability — aborting remaining checks");
+        std::process::exit(1);
+    }
+
+    // 2. /props responds
+    let props_ok = ssh_probe(
+        host,
+        "curl -sf http://localhost:8080/props >/dev/null && echo yes || echo no",
+    )
+    .as_deref()
+        == Some("yes");
+    checks.push(("/props HTTP endpoint".to_string(), props_ok, String::new()));
+
+    // 3. Ministral chat returns >=1 token
+    let ministral_chat = ssh_probe(host, r#"curl -sf -X POST http://localhost:8080/v1/chat/completions -H 'Content-Type: application/json' -d '{"model":"ministral","messages":[{"role":"user","content":"hello"}],"max_tokens":5}' | head -c 200"#).unwrap_or_default();
+    let ministral_ok = ministral_chat.contains("\"content\"") && !ministral_chat.contains("error");
+    checks.push((
+        "Ministral-3-3B chat ≥1 token".to_string(),
+        ministral_ok,
+        ministral_chat.chars().take(100).collect(),
+    ));
+
+    // 4. Qwen chat returns >=1 token (after switching model)
+    let _ = ssh_probe(host, "sed -i -E 's|^#?\\s*MODEL_PATH=.*|MODEL_PATH=/models/Qwen3.5-2B-Q8_0.gguf|' /etc/whitt-neuron/llama.env && systemctl restart llama-server.service && sleep 5");
+    let qwen_chat = ssh_probe(host, r#"curl -sf -X POST http://localhost:8080/v1/chat/completions -H 'Content-Type: application/json' -d '{"model":"qwen","messages":[{"role":"user","content":"hello"}],"max_tokens":5}' | head -c 200"#).unwrap_or_default();
+    let qwen_ok = qwen_chat.contains("\"content\"") && !qwen_chat.contains("error");
+    checks.push((
+        "Qwen3.5-2B chat ≥1 token".to_string(),
+        qwen_ok,
+        qwen_chat.chars().take(100).collect(),
+    ));
+
+    // 5. UFW blocks random port 9999
+    let ufw_block = ssh_probe(
+        host,
+        "ufw status | grep -q '9999' && echo BLOCKED || echo ALLOWED",
+    )
+    .map(|s| s.contains("ALLOWED"))
+    .unwrap_or(true);
+    let ufw_ok = !ufw_block;
+    checks.push(("UFW denies port 9999".to_string(), ufw_ok, String::new()));
+
+    // 6. fleet entry exists (host-side)
+    let fleet = SbcFleet::load().unwrap_or_default();
+    let fleet_ok = fleet.entries().iter().any(|(_, e)| e.host == host);
+    checks.push((format!("fleet entry for {}", host), fleet_ok, String::new()));
+
+    // Report
+    println!("\n--- Results ---");
+    for (name, ok, detail) in &checks {
+        let mark = if *ok { "PASS" } else { "FAIL" };
+        println!("{}: {}", mark, name);
+        if !ok && !detail.is_empty() {
+            println!("       detail: {}", detail);
+        }
+        if *ok {
+            pass += 1;
+        } else {
+            fail += 1;
+        }
+    }
+    println!("\n{}/{} passed ({} failed)", pass, pass + fail, fail);
+    if fail > 0 {
+        std::process::exit(1);
+    }
+    Ok(())
+}
