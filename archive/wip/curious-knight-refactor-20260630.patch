+async fn sbc_command(action: SbcAction) -> Result<()> {
+    match action {
+        SbcAction::Info { format } => {
+            print_sbc_info(&format);
+            Ok(())
+        }
+        SbcAction::Install {
+            script,
+            host,
+            user,
+            from_ci_artifact,
+            embed_config,
+            cross_llama,
+        } => {
+            print_sbc_install(
+                script,
+                &host,
+                &user,
+                from_ci_artifact,
+                embed_config,
+                cross_llama,
+            );
+            Ok(())
+        }
+        SbcAction::Doctor { host, json, hint } => run_sbc_doctor(&host, json, hint).await,
+        SbcAction::Model { action } => match action {
+            SbcModelAction::List { host } => sbc_model_list(&host).await,
+            SbcModelAction::Switch { name, host } => sbc_model_switch(&host, &name).await,
+            SbcModelAction::Pull { repo, file, host } => {
+                sbc_model_pull(&host, &repo, file.as_deref()).await
+            }
+        },
+        SbcAction::Discover { subnet, port } => sbc_discover(subnet.as_deref(), port).await,
+        SbcAction::Logs {
+            follow,
+            since,
+            host,
+        } => sbc_logs(&host, follow, since.as_deref()).await,
+        SbcAction::Status { host, wait } => sbc_status(&host, wait).await,
+        SbcAction::Start { host, model } => sbc_service_set(&host, true, model.as_deref()).await,
+        SbcAction::Stop { host } => sbc_service_set(&host, false, None).await,
+        SbcAction::Verify { host } => sbc_verify(&host).await,
+        SbcAction::Bench { host, extra } => sbc_bench(&host, extra.as_deref()).await,
+        SbcAction::Backup { host, out_dir } => {
+            let out = out_dir
+                .clone()
+                .unwrap_or_else(|| std::env::var("HOME").unwrap_or_else(|_| ".".to_string()));
+            sbc_backup(&host, &out).await
+        }
+        SbcAction::Usage { host } => sbc_usage(&host).await,
+        SbcAction::Audit { host, follow } => sbc_audit(&host, follow).await,
+        SbcAction::Maintenance { host, on, off } => {
+            if on == off {
+                anyhow::bail!("must pass exactly one of --on or --off");
+            }
+            sbc_maintenance(&host, on).await
+        }
+        SbcAction::Update {
+            host,
+            prerelease,
+            version,
+        } => sbc_update(&host, prerelease, version.as_deref()).await,
+        SbcAction::Llama { action } => match action {
+            LlamaAction::Update { tag, host } => sbc_llama_update(&host, &tag).await,
+        },
+        SbcAction::FactoryReset { host, yes } => sbc_factory_reset(&host, yes).await,
+        SbcAction::Add { alias, host, user } => {
+            let mut fleet = SbcFleet::load()?;
+            fleet.add(alias.clone(), host.clone(), user.clone());
+            fleet.save()?;
+            println!("added {} -> {}@{}", alias, user, host);
+            Ok(())
+        }
+        SbcAction::List => {
+            let fleet = SbcFleet::load()?;
+            if fleet.is_empty() {
+                println!("(no SBCs in fleet — add with: whitt sbc add <alias> <host>)");
+            } else {
+                println!("{:<15} {:<30} {:<10}", "ALIAS", "HOST", "USER");
+                for (alias, entry) in fleet.entries() {
+                    println!("{:<15} {:<30} {:<10}", alias, entry.host, entry.user);
+                }
+            }
+            Ok(())
+        }
+        SbcAction::Remove { alias } => {
+            let mut fleet = SbcFleet::load()?;
+            if fleet.remove(&alias) {
+                fleet.save()?;
+                println!("removed {}", alias);
+            } else {
+                println!("(no fleet entry named {})", alias);
+            }
+            Ok(())
+        }
+        SbcAction::Completions { shell } => generate_completions(shell),
+    }
+}
