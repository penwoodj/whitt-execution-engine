+async fn sbc_model_switch(host: &str, name: &str) -> Result<()> {
+    let candidate = if name.ends_with(".gguf") {
+        name.to_string()
+    } else {
+        format!("{}.gguf", name)
+    };
+    let path = if name.starts_with('/') {
+        name.to_string()
+    } else {
+        format!("/models/{}", candidate)
+    };
+    println!("==> Switching {} to {}", host, path);
+    let check = ssh_probe(
+        host,
+        &format!("test -f {} && echo present || echo absent", path),
+    );
+    if !matches!(check.as_deref(), Some("present")) {
+        anyhow::bail!(
+            "model file {} not present on {} (checked via ssh: {:?})",
+            path,
+            host,
+            check
+        );
+    }
+    let cmd = format!(
+        "sed -i -E 's|^#?\\s*MODEL_PATH=.*|MODEL_PATH={}|' /etc/whitt-neuron/llama.env \
+         && systemctl restart llama-server.service",
+        path
+    );
+    match ssh_probe(host, &cmd) {
+        Some(s) if s.contains("auth failed") || s.contains("unreachable") => {
+            anyhow::bail!("ssh failed: {}", s)
+        }
+        _ => println!(
+            "switched to {} and restarted llama-server.service — check with `whitt sbc status --host {}`",
+            path, host
+        ),
+    }
+    Ok(())
+}
