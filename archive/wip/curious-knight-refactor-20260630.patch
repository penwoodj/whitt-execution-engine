+#[allow(clippy::too_many_lines)]
+async fn sbc_usage(host: &str) -> Result<()> {
+    println!("==> Usage stats from {} (Q41)", host);
+    // llama-server /metrics exposes Prometheus-format metrics
+    let metrics =
+        ssh_probe(host, "curl -sf http://localhost:8080/metrics 2>/dev/null").unwrap_or_default();
+    if metrics.is_empty() {
+        println!("(no metrics — llama-server not running or /metrics unavailable)");
+        return Ok(());
+    }
+    // Extract key metrics
+    let extract = |key: &str| -> String {
+        for line in metrics.lines() {
+            if line.starts_with(key) && !line.starts_with('#') {
+                return line.to_string();
+            }
+        }
+        format!("{}: (not found)", key)
+    };
+    println!("\n--- llama-server metrics ---");
+    println!("{}", extract("llama_training_tokens_seconds"));
+    println!("{}", extract("llama_inference_tokens_seconds_total"));
+    println!("{}", extract("llama_inference_requests_total"));
+    println!("{}", extract("llama_inference_active_requests"));
+    println!("{}", extract("llama_model_load_time_seconds"));
+    // also show active model
+    let active = ssh_probe(
+        host,
+        "grep -E '^MODEL_PATH=' /etc/whitt-neuron/llama.env | cut -d= -f2-",
+    )
+    .unwrap_or_else(|| "(unknown)".to_string());
+    println!("\nActive model: {}", active);
+    Ok(())
+}
