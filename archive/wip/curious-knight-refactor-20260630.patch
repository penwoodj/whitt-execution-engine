+async fn run_sbc_doctor(host: &str, json: bool, hint: bool) -> Result<()> {
+    use std::process::Command;
+
+    if !json {
+        println!("whitt sbc doctor — target: {}", host);
+        println!("==========================================");
+    }
+
+    let mut checks: Vec<SbcCheck> = Vec::new();
+    let local_arch = std::env::consts::ARCH;
+    let on_sbc = local_arch == "aarch64" || local_arch == "arm64";
+
+    checks.push(run_check("local_arch", || {
+        (local_arch.to_string(), SbcCheck::OK)
+    }));
+
+    if on_sbc {
+        checks.push(run_check("on_sbc", || ("yes".to_string(), SbcCheck::OK)));
+
+        checks.push(run_check("dev_dri_present", || {
+            let has = std::path::Path::new("/dev/dri").exists();
+            (
+                if has {
+                    "present".to_string()
+                } else {
+                    "absent".to_string()
+                },
+                if has { SbcCheck::WARN } else { SbcCheck::OK },
+            )
+        }));
+
+        checks.push(run_check("mem_total", || {
+            if let Ok(meminfo) = std::fs::read_to_string("/proc/meminfo") {
+                for line in meminfo.lines() {
+                    if line.starts_with("MemTotal:") {
+                        return (
+                            line.trim_start_matches("MemTotal:").trim().to_string(),
+                            SbcCheck::OK,
+                        );
+                    }
+                }
+            }
+            ("(unreadable)".to_string(), SbcCheck::WARN)
+        }));
+
+        checks.push(run_check("nproc", || {
+            match Command::new("nproc").output() {
+                Ok(o) if o.status.success() => (
+                    String::from_utf8_lossy(&o.stdout).trim().to_string(),
+                    SbcCheck::OK,
+                ),
+                _ => ("(nproc failed)".to_string(), SbcCheck::WARN),
+            }
+        }));
+
+        checks.push(run_check("llama_server", || {
+            match Command::new("llama-server").arg("--version").output() {
+                Ok(o) if o.status.success() => (
+                    String::from_utf8_lossy(&o.stdout)
+                        .lines()
+                        .next()
+                        .unwrap_or("(unknown)")
+                        .to_string(),
+                    SbcCheck::OK,
+                ),
+                Ok(_) => ("installed but --version failed".to_string(), SbcCheck::WARN),
+                Err(_) => (
+                    "NOT FOUND (build llama.cpp on the SBC)".to_string(),
+                    SbcCheck::FAIL,
+                ),
+            }
+        }));
+
+        checks.push(run_check("libgomp1", || {
+            match Command::new("sh")
+                .args([
+                    "-c",
+                    "ldconfig -p | grep -q libgomp.so.1 && echo present || echo missing",
+                ])
+                .output()
+            {
+                Ok(o) if o.status.success() => {
+                    let v = String::from_utf8_lossy(&o.stdout).trim().to_string();
+                    let status = if v == "present" {
+                        SbcCheck::OK
+                    } else {
+                        SbcCheck::FAIL
+                    };
+                    (v, status)
+                }
+                _ => ("(ldconfig unavailable)".to_string(), SbcCheck::WARN),
+            }
+        }));
+
+        checks.push(run_check("libstdcxx6", || {
+            match Command::new("sh")
+                .args([
+                    "-c",
+                    "ldconfig -p | grep -q libstdc++.so.6 && echo present || echo missing",
+                ])
+                .output()
+            {
+                Ok(o) if o.status.success() => {
+                    let v = String::from_utf8_lossy(&o.stdout).trim().to_string();
+                    let status = if v == "present" {
+                        SbcCheck::OK
+                    } else {
+                        SbcCheck::FAIL
+                    };
+                    (v, status)
+                }
+                _ => ("(ldconfig unavailable)".to_string(), SbcCheck::WARN),
+            }
+        }));
+
+        checks.push(run_check("config_yml", || {
+            let p = std::path::Path::new("/etc/whitt/config.yml");
+            if !p.exists() {
+                return (
+                    "missing (run whitt sbc install --embed-config)".to_string(),
+                    SbcCheck::WARN,
+                );
+            }
+            match std::fs::read_to_string(p) {
+                Ok(content) if !content.trim().is_empty() => ("present".to_string(), SbcCheck::OK),
+                Ok(_) => ("empty".to_string(), SbcCheck::WARN),
+                Err(e) => (format!("unreadable: {}", e), SbcCheck::WARN),
+            }
+        }));
+    } else {
+        checks.push(run_check("on_sbc", || {
+            ("no (remote probe via ssh)".to_string(), SbcCheck::OK)
+        }));
+        let ssh_checks = [
+            ("remote_arch", "uname -m"),
+            (
+                "remote_dev_dri",
+                "test -d /dev/dri && echo present || echo absent",
+            ),
+            ("remote_mem_total", "grep MemTotal /proc/meminfo"),
+            ("remote_nproc", "nproc"),
+            ("remote_llama_server", "which llama-server || echo MISSING"),
+            ("remote_whitt", "which whitt || echo MISSING"),
+            (
+                "remote_libgomp1",
+                "ldconfig -p 2>/dev/null | grep -q libgomp.so.1 && echo present || echo missing",
+            ),
+            (
+                "remote_libstdcxx6",
+                "ldconfig -p 2>/dev/null | grep -q libstdc++.so.6 && echo present || echo missing",
+            ),
+            (
+                "remote_config_yml",
+                "test -f /etc/whitt/config.yml && echo present || echo missing",
+            ),
+        ];
+        for (name, cmd) in ssh_checks {
+            let result_name: &'static str = Box::leak(name.to_string().into_boxed_str());
+            checks.push(run_check(result_name, || match ssh_probe(host, cmd) {
+                Some(v) => {
+                    let is_missing = v.contains("MISSING") || v.contains("missing");
+                    let is_unreachable = v.contains("unreachable") || v.contains("ssh auth failed");
+                    let status = if is_unreachable {
+                        SbcCheck::FAIL
+                    } else if is_missing {
+                        SbcCheck::WARN
+                    } else {
+                        SbcCheck::OK
+                    };
+                    (v, status)
+                }
+                None => (
+                    "(ssh binary unavailable or command failed)".to_string(),
+                    SbcCheck::FAIL,
+                ),
+            }));
+        }
+    }
+
+    checks.push(run_check("hf_token_set", || {
+        let set =
+            std::env::var("HUGGING_FACE_HUB_TOKEN").is_ok() || std::env::var("HF_TOKEN").is_ok();
+        (
+            if set {
+                "set".to_string()
+            } else {
+                "unset".to_string()
+            },
+            if set { SbcCheck::OK } else { SbcCheck::WARN },
+        )
+    }));
+
+    let server_url = format!("http://{}:8080/props", host);
+    let probe_start = std::time::Instant::now();
+    let probe = reqwest::Client::builder()
+        .timeout(std::time::Duration::from_secs(5))
+        .build()?
+        .get(&server_url)
+        .send()
+        .await;
+    let probe_check = match probe {
+        Ok(resp) if resp.status().is_success() => SbcCheck {
+            name: "llama_server_http",
+            status: SbcCheck::OK,
+            value: format!("REACHABLE HTTP {}", resp.status()),
+            duration_ms: probe_start.elapsed().as_millis(),
+        },
+        Ok(resp) => SbcCheck {
+            name: "llama_server_http",
+            status: SbcCheck::WARN,
+            value: format!("non-2xx HTTP {}", resp.status()),
+            duration_ms: probe_start.elapsed().as_millis(),
+        },
+        Err(e) => SbcCheck {
+            name: "llama_server_http",
+            status: SbcCheck::FAIL,
+            value: format!("NOT REACHABLE: {}", e),
+            duration_ms: probe_start.elapsed().as_millis(),
+        },
+    };
+    checks.push(probe_check);
+
+    if json {
+        let json = serde_json::to_string_pretty(&checks)?;
+        println!("{}", json);
+    } else {
+        for c in &checks {
+            println!("{:<22}: {}", c.name, c.value);
+        }
+    }
+
+    let worst = checks
+        .iter()
+        .map(|c| match c.status {
+            SbcCheck::FAIL => 2,
+            SbcCheck::WARN => 1,
+            _ => 0,
+        })
+        .max()
+        .unwrap_or(0);
+
+    // Q49: actionable hints for warn/fail checks
+    if hint && !json && worst > 0 {
+        println!("\n--- Hints ---");
+        for c in &checks {
+            if c.status == SbcCheck::OK {
+                continue;
+            }
+            let h = doctor_hint(&c.name, c.status);
+            if !h.is_empty() {
+                println!("{}: {}", c.name, h);
+            }
+        }
+    }
+
+    if worst > 0 && !json {
+        eprintln!(
+            "\nDoctor completed with {} (exit code {})",
+            if worst == 2 { "failures" } else { "warnings" },
+            worst
+        );
+    }
+    if worst >= 2 {
+        std::process::exit(2);
+    } else if worst == 1 {
+        std::process::exit(1);
+    }
+    Ok(())
+}
