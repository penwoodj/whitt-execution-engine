+fn print_sbc_info(format: &str) {
+    let info = r#"ARM64 SBC deployment target (Orange Pi Zero 3W / Allwinner A733)
+
+Hardware:
+  - SoC: Allwinner A733, 8-core (2x A76 @2.0GHz + 6x A55 @1.8GHz)
+  - RAM: 12GB LPDDR5 @2400MHz 32-bit (~9.6 GB/s peak; SBC variants may differ)
+  - GPU: PowerVR BXM-4-64 (NO open-source Vulkan userspace on stock BSP images)
+  - Arch: ARM64 (aarch64)
