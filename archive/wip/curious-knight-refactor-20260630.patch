+#[allow(non_snake_case)]
+fn doctor_hint(name: &str, status: &str) -> String {
+    let prefix = if status == "fail" { "FIX" } else { "HINT" };
+    match name {
+        "ssh" | "remote_ssh" => format!("{}: ssh-keygen -t ed25519; ssh-copy-id root@<host> — or check ~/.ssh/id_ed25519.pub is in /root/.ssh/authorized_keys on SBC", prefix),
+        "llama_server" | "remote_llama_server" => format!("{}: systemctl status llama-server on SBC; if 'failed' → check /var/log/llama-server.log; if 'inactive' → run: whitt sbc start --host <host>", prefix),
+        "llama_server_http" | "remote_llama_server_http" => format!("{}: curl http://<host>:8080/props from SBC; if connection refused → llama-server not running; if timeout → UFW blocking 8080", prefix),
+        "config_yml" | "remote_config_yml" => format!("{}: cat /etc/whitt/config.yml on SBC; should have model:/context:/hardware: sections. Regenerate: whitt sbc install --script --embed-config", prefix),
+        "libgomp1" | "remote_libgomp1" => format!("{}: apt install libgomp1 on SBC (OpenMP runtime for llama.cpp)", prefix),
+        "libstdcxx6" | "remote_libstdcxx6" => format!("{}: apt install libstdc++6 on SBC (C++ runtime)", prefix),
+        "hf_token_set" | "remote_hf_token_set" => format!("{}: huggingface-cli login on SBC, or set HF_TOKEN in /etc/whitt-neuron/llama.env", prefix),
+        "mem_total" | "remote_mem_total" => format!("{}: free -h on SBC; if <8GB free → switch to smaller model: whitt sbc model switch Qwen3.5-2B-Q8_0", prefix),
+        "nproc" | "remote_nproc" => format!("{}: nproc should be 8 on A733 (2×A76 + 6×A55); check /proc/cpuinfo", prefix),
+        "dev_dri_present" | "remote_dev_dri_present" => format!("{}: /dev/dri absent on A733 (no GPU) — expected for CPU-only mode", prefix),
+        _ => String::new(),
+    }
+}
+
+// SBC helpers — fleet config, model switch, logs, status, updates, completions
+
+#[derive(Debug, serde::Serialize, serde::Deserialize, Default)]
+struct SbcFleet {
+    #[serde(default)]
+    sbcs: std::collections::HashMap<String, SbcEntry>,
+}
+
+#[derive(Debug, serde::Serialize, serde::Deserialize, Clone)]
+struct SbcEntry {
+    host: String,
+    user: String,
+}
+
+impl SbcFleet {
+    fn path() -> std::path::PathBuf {
+        let mut p = dirs::config_dir().unwrap_or_else(|| std::path::PathBuf::from("."));
+        p.push("whitt");
+        p.push("sbcs.json");
+        p
+    }
+
+    fn load() -> Result<Self> {
+        let path = Self::path();
+        if !path.exists() {
+            return Ok(Self::default());
+        }
+        let content = std::fs::read_to_string(&path)
+            .map_err(|e| anyhow::anyhow!("failed to read {}: {}", path.display(), e))?;
+        if content.trim().is_empty() {
+            return Ok(Self::default());
+        }
+        Ok(serde_json::from_str(&content)
+            .map_err(|e| anyhow::anyhow!("failed to parse {}: {}", path.display(), e))?)
+    }
+
+    fn save(&self) -> Result<()> {
+        let path = Self::path();
+        if let Some(parent) = path.parent() {
+            std::fs::create_dir_all(parent)
+                .map_err(|e| anyhow::anyhow!("failed to create {}: {}", parent.display(), e))?;
+        }
+        let json = serde_json::to_string_pretty(self)
+            .map_err(|e| anyhow::anyhow!("failed to serialize fleet: {}", e))?;
+        std::fs::write(&path, json)
+            .map_err(|e| anyhow::anyhow!("failed to write {}: {}", path.display(), e))?;
+        Ok(())
+    }
+
+    fn add(&mut self, alias: String, host: String, user: String) {
+        self.sbcs.insert(alias, SbcEntry { host, user });
+    }
+
+    fn remove(&mut self, alias: &str) -> bool {
+        self.sbcs.remove(alias).is_some()
+    }
+
+    fn is_empty(&self) -> bool {
+        self.sbcs.is_empty()
+    }
+
+    fn entries(&self) -> Vec<(&String, &SbcEntry)> {
+        let mut v: Vec<_> = self.sbcs.iter().collect();
+        v.sort_by(|a, b| a.0.cmp(b.0));
+        v
+    }
+}
