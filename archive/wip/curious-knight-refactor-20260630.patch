+async fn sbc_service_set(host: &str, start: bool, model: Option<&str>) -> Result<()> {
+    let verb = if start { "start" } else { "stop" };
+    println!("==> systemctl {} llama-server.service on {}", verb, host);
+
+    // Q43: optionally override MODEL_PATH before start
+    if start {
+        if let Some(m) = model {
+            let candidate = if m.ends_with(".gguf") {
+                m.to_string()
+            } else {
+                format!("{}.gguf", m)
+            };
+            let path = if m.starts_with('/') {
+                m.to_string()
+            } else {
+                format!("/models/{}", candidate)
+            };
+            println!("    overriding MODEL_PATH={}", path);
+            let escaped = path.replace('\'', "'\\''");
+            let _ = ssh_probe(
+                host,
+                &format!(
+                    "sed -i -E 's|^#?\\s*MODEL_PATH=.*|MODEL_PATH={}|' /etc/whitt-neuron/llama.env",
+                    escaped
+                ),
+            );
+            // audit log
+            let _ = ssh_probe(host, &format!(
+                "echo '{{\"ts\":\"$(date -Iseconds)\",\"user\":\"${{USER:-unknown}}\",\"action\":\"start\",\"model\":\"{}\",\"success\":true}}' >> /var/log/whitt-neuron/audit.jsonl 2>/dev/null || true",
+                escaped
+            ));
+        }
+    }
+
+    // Q34: pre-flight RAM check on start — refuse if model larger than free RAM
+    if start {
+        if let Some(model_path) = ssh_probe(
+            host,
+            "grep -E '^MODEL_PATH=' /etc/whitt-neuron/llama.env 2>/dev/null | cut -d= -f2-",
+        )
+        .and_then(|s| {
+            let trimmed = s.trim().to_string();
+            if trimmed.is_empty() {
+                None
+            } else {
+                Some(trimmed)
+            }
+        }) {
+            let model_size_kb = ssh_probe(
+                host,
+                &format!(
+                    "stat -c %s '{}' 2>/dev/null || echo 0",
+                    model_path.replace('\'', "'\\''")
+                ),
+            )
+            .and_then(|s| s.trim().parse::<u64>().ok())
+            .unwrap_or(0)
+                / 1024;
+            let free_ram_kb = ssh_probe(host, "awk '/^MemAvailable:/ {print $2}' /proc/meminfo")
+                .and_then(|s| s.trim().parse::<u64>().ok())
+                .unwrap_or(0);
+            if model_size_kb > 0 && free_ram_kb > 0 && model_size_kb > free_ram_kb {
+                // audit log: failure
+                let _ = ssh_probe(host, &format!(
+                    "echo '{{\"ts\":\"$(date -Iseconds)\",\"user\":\"${{USER:-unknown}}\",\"action\":\"start\",\"model\":\"{}\",\"success\":false,\"reason\":\"oom_preflight\"}}' >> /var/log/whitt-neuron/audit.jsonl 2>/dev/null || true",
+                    model_path.replace('\'', "'\\''")
+                ));
+                anyhow::bail!(
+                    "model {} ({}KB) larger than free RAM ({}KB) — refusing to start. Switch to smaller model: whitt sbc model switch Qwen3.5-2B-Q8_0 --host {}",
+                    model_path, model_size_kb, free_ram_kb, host
+                );
+            }
+            println!(
+                "    RAM pre-flight OK: model {}KB, free {}KB",
+                model_size_kb, free_ram_kb
+            );
+        }
+    }
+
+    let result = ssh_probe(host, &format!("systemctl {} llama-server.service", verb));
+    match result {
+        Some(s) if s.contains("auth failed") || s.contains("unreachable") => {
+            anyhow::bail!("ssh failed: {}", s)
+        }
+        _ => println!("llama-server.service {}ed on {}", verb, host),
+    }
+    Ok(())
+}
