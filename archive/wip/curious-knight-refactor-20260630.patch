+#[derive(serde::Serialize)]
+struct SbcCheck {
+    name: &'static str,
+    status: &'static str,
+    value: String,
+    duration_ms: u128,
+}
+
+impl SbcCheck {
+    const OK: &'static str = "ok";
+    const WARN: &'static str = "warn";
+    const FAIL: &'static str = "fail";
+}
+
+fn run_check<F: FnOnce() -> (String, &'static str)>(name: &'static str, f: F) -> SbcCheck {
+    let start = std::time::Instant::now();
+    let (value, status) = f();
+    SbcCheck {
+        name,
+        status,
+        value,
+        duration_ms: start.elapsed().as_millis(),
+    }
+}
+
+fn ssh_probe(host: &str, cmd: &str) -> Option<String> {
+    let out = std::process::Command::new("ssh")
+        .args([
+            "-o",
+            "ConnectTimeout=5",
+            "-o",
+            "BatchMode=yes",
+            "-o",
+            "StrictHostKeyChecking=accept-new",
+            &format!("root@{}", host),
+            cmd,
+        ])
+        .output()
+        .ok()?;
+    if out.status.success() {
+        Some(String::from_utf8_lossy(&out.stdout).trim().to_string())
+    } else {
+        let stderr = String::from_utf8_lossy(&out.stderr).trim().to_string();
+        if stderr.contains("Permission denied") {
+            Some("(ssh auth failed — set up key auth to root@host)".to_string())
+        } else if stderr.contains("Could not resolve hostname")
+            || stderr.contains("Connection timed out")
+        {
+            Some("(unreachable — check host/IP or network)".to_string())
+        } else if !stderr.is_empty() {
+            Some(stderr)
+        } else {
+            None
+        }
+    }
+}
+
+fn ssh_probe_interactive(host: &str, cmd: &str) -> Option<String> {
+    // For follow-mode commands (tail -f). Inherits stdio so user sees live output.
+    let status = std::process::Command::new("ssh")
+        .args([
+            "-o",
+            "ConnectTimeout=5",
+            "-o",
+            "BatchMode=yes",
+            "-o",
+            "StrictHostKeyChecking=accept-new",
+            &format!("root@{}", host),
+            cmd,
+        ])
+        .status()
+        .ok()?;
+    if status.success() {
+        Some(String::new())
+    } else {
+        None
+    }
+}
