+async fn sbc_backup(host: &str, out_dir: &str) -> Result<()> {
+    let date = std::process::Command::new("date")
+        .arg("+%Y%m%d")
+        .output()
+        .map(|o| String::from_utf8_lossy(&o.stdout).trim().to_string())
+        .map_err(|e| anyhow::anyhow!("date failed: {}", e))?;
+    let safe_host = host.replace('.', "_");
+    let filename = format!("whitt-{}-{}.img.gz", safe_host, date);
+    let path = format!("{}/{}", out_dir.trim_end_matches('/'), filename);
+    println!("==> Backing up {} to {} (Q36 — dd + gzip)", host, path);
+
+    // Q48: cleanup — keep last 3 backups for this host, delete older
+    let pattern = format!("whitt-{}-*.img.gz", safe_host);
+    let cleanup = std::process::Command::new("bash")
+        .arg("-c")
+        .arg(format!(
+            "cd '{}' && ls -1t {} 2>/dev/null | tail -n +4 | xargs -r rm -v",
+            out_dir, pattern
+        ))
+        .output();
+    if let Ok(out) = cleanup {
+        let removed = String::from_utf8_lossy(&out.stdout);
+        if !removed.is_empty() {
+            println!(
+                "    (Q48) removed old backups: {}",
+                removed.replace('\n', ", ")
+            );
+        }
+    }
+
+    // Stream dd output over ssh, pipe through local gzip
+    let status = std::process::Command::new("ssh")
+        .args([
+            "-o",
+            "ConnectTimeout=10",
+            "-o",
+            "BatchMode=yes",
+            "-o",
+            "StrictHostKeyChecking=accept-new",
+            &format!("root@{}", host),
+            "dd if=/dev/mmcblk0 bs=4M status=none",
+        ])
+        .stdout(std::process::Stdio::piped())
+        .spawn()
+        .map_err(|e| anyhow::anyhow!("ssh spawn failed: {}", e))?;
+
+    let gzip = std::process::Command::new("gzip")
+        .arg("-9")
+        .arg("-c")
+        .stdin(std::process::Stdio::from(status.stdout.unwrap()))
+        .stdout(std::process::Stdio::from(
+            std::fs::File::create(&path)
+                .map_err(|e| anyhow::anyhow!("create {} failed: {}", path, e))?,
+        ))
+        .status()
+        .map_err(|e| anyhow::anyhow!("gzip failed: {}", e))?;
+
+    if !gzip.success() {
+        anyhow::bail!("gzip/dd pipeline failed (exit {:?})", gzip.code());
+    }
+    let size = std::fs::metadata(&path).map(|m| m.len()).unwrap_or(0);
+    println!("Done: {} ({} bytes, ~{}MB)", path, size, size / 1024 / 1024);
+    println!(
+        "Restorable via: gunzip -c {} | sudo dd of=/dev/sdX bs=4M",
+        path
+    );
+    Ok(())
+}
+
+async fn sbc_discover(subnet: Option<&str>, port: u16) -> Result<()> {
+    let cidr = match subnet {
+        Some(s) => s.to_string(),
+        None => {
+            let out = std::process::Command::new("ip")
+                .args(["-4", "-o", "route", "show", "default"])
+                .output()
+                .map_err(|e| anyhow::anyhow!("ip route failed: {}", e))?;
+            let stdout = String::from_utf8_lossy(&out.stdout);
+            let dev = stdout
+                .split_whitespace()
+                .find(|t| t.starts_with("dev"))
+                .and_then(|_| stdout.split("dev ").nth(1))
+                .and_then(|s| s.split_whitespace().next())
+                .ok_or_else(|| anyhow::anyhow!("no default route — pass --subnet"))?;
+            let addr_out = std::process::Command::new("ip")
+                .args(["-4", "-o", "addr", "show", "dev", dev])
+                .output()
+                .map_err(|e| anyhow::anyhow!("ip addr failed: {}", e))?;
+            let addr_stdout = String::from_utf8_lossy(&addr_out.stdout);
+            let ip_prefix = addr_stdout
+                .split_whitespace()
+                .find(|t| t.contains('/'))
+                .ok_or_else(|| anyhow::anyhow!("no IPv4 address on {}", dev))?;
+            let base = ip_prefix.split('.').take(3).collect::<Vec<_>>().join(".");
+            format!("{}.0/24", base)
+        }
+    };
+
+    let base = cidr
+        .split('/')
+        .next()
+        .and_then(|s| s.rsplit_once('.'))
+        .map(|(b, _)| b.to_string())
+        .ok_or_else(|| anyhow::anyhow!("invalid CIDR: {}", cidr))?;
+
+    println!("==> Scanning {}:{} (this takes ~5s)", cidr, port);
+
+    let mut tasks = Vec::new();
+    for i in 1..255u8 {
+        let ip = format!("{}.{}", base, i);
+        tasks.push(tokio::spawn(async move {
+            let client = reqwest::Client::builder()
+                .timeout(std::time::Duration::from_millis(500))
+                .build()
+                .ok()?;
+            let url = format!("http://{}:{}/props", ip, port);
+            let resp = client.get(&url).send().await.ok()?;
+            if !resp.status().is_success() {
+                return None;
+            }
+            let body = resp.text().await.ok()?;
+            if body.contains("llama") || body.contains("total_slots") {
+                Some((ip, body))
+            } else {
+                None
+            }
+        }));
+    }
+
+    let mut found: Vec<(String, String)> = Vec::new();
+    for t in tasks {
+        if let Ok(Some((ip, body))) = t.await {
+            let tag = body
+                .lines()
+                .find(|l| l.contains("llama") || l.contains("build"))
+                .map(|l| l.trim().to_string())
+                .unwrap_or_else(|| "(llama-server)".to_string());
+            found.push((ip, tag));
+        }
+    }
+    found.sort();
+
+    if found.is_empty() {
+        println!("(no llama-server instances found on {}:{})", cidr, port);
+    } else {
+        println!("{:<16} {}", "IP", "IDENTIFY");
+        for (ip, tag) in &found {
+            println!("{:<16} {}", ip, tag);
+        }
+    }
+    Ok(())
+}
+
+async fn sbc_logs(host: &str, follow: bool, since: Option<&str>) -> Result<()> {
+    let mut args = vec![
+        "-o".to_string(),
+        "ConnectTimeout=5".to_string(),
+        "-o".to_string(),
+        "BatchMode=yes".to_string(),
+        "-o".to_string(),
+        "StrictHostKeyChecking=accept-new".to_string(),
+        format!("root@{}", host),
+    ];
+    let mut cmd = String::from("journalctl -u llama-server");
+    if follow {
+        cmd.push_str(" -f --no-pager");
+    } else {
+        cmd.push_str(" --no-pager -n 200");
+    }
+    if let Some(s) = since {
+        cmd.push_str(&format!(" --since {}", s));
+    }
+    args.push(cmd);
+
+    let mut child = std::process::Command::new("ssh")
+        .args(&args)
+        .spawn()
+        .map_err(|e| anyhow::anyhow!("ssh spawn failed: {}", e))?;
+    let status = child
+        .wait()
+        .map_err(|e| anyhow::anyhow!("ssh wait failed: {}", e))?;
+    if !status.success() && !follow {
+        anyhow::bail!("ssh journalctl exited with status {:?}", status.code());
+    }
+    Ok(())
+}
+
+async fn sbc_status(host: &str, wait: bool) -> Result<()> {
+    loop {
+        let firstboot_done = ssh_probe(
+            host,
+            "test -f /var/lib/whitt-neuron/firstboot.done && echo yes || echo no",
+        );
+        let service_state = ssh_probe(host, "systemctl is-active llama-server.service 2>/dev/null");
+        let service_enabled = ssh_probe(
+            host,
+            "systemctl is-enabled llama-server.service 2>/dev/null",
+        );
+
+        let state = {
+            let fb = firstboot_done.as_deref();
+            let ss = service_state.as_deref();
+            let unreachable = fb.map_or(true, |s| {
+                s.contains("unreachable") || s.contains("auth failed")
+            }) || ss.map_or(true, |s| {
+                s.contains("unreachable") || s.contains("auth failed")
+            });
+            if unreachable {
+                "offline".to_string()
+            } else if fb == Some("no") {
+                "building".to_string()
+            } else if fb == Some("yes") {
+                match ss {
+                    Some("active") => "ready".to_string(),
+                    Some("failed") => "failed".to_string(),
+                    Some(other) => format!("service:{}", other),
+                    None => "unknown".to_string(),
+                }
+            } else {
+                "unknown".to_string()
+            }
+        };
+
+        println!(
+            "{:<20} firstboot={} service={:<10} enabled={:<10}",
+            state,
+            firstboot_done.as_deref().unwrap_or("?"),
+            service_state.as_deref().unwrap_or("?"),
+            service_enabled.as_deref().unwrap_or("?")
+        );
+
+        // Q31: progress % + ETA when building (parse cmake build progress from firstboot.log)
+        if wait && state == "building" {
+            if let Some(progress) = ssh_probe(host, "tail -n 200 /var/log/whitt-neuron-firstboot.log 2>/dev/null | grep -oE '\\[([0-9]+)%\\]' | tail -1 | tr -d '[]%'") {
+                if let Ok(pct) = progress.trim().parse::<u32>() {
+                    let elapsed_min = ssh_probe(host, "echo $(( ($(date +%s) - $(stat -c %Y /var/log/whitt-neuron-firstboot.log 2>/dev/null || echo $(date +%s))) / 60 ))")
+                        .and_then(|s| s.trim().parse::<u32>().ok())
+                        .unwrap_or(0);
+                    let eta_min = if pct > 0 && pct < 100 {
+                        (elapsed_min as u64 * (100 - pct as u64) / pct as u64).max(1)
+                    } else {
+                        0
+                    };
+                    println!("    build progress: {}% — elapsed {}m, ETA ~{}m", pct, elapsed_min, eta_min);
+                }
+            }
+        }
+
+        if !wait || state == "ready" || state == "failed" || state == "offline" {
+            // Q44: auto-check for newer whitt release on GitHub
+            if state == "ready" {
+                if let Ok(latest) = std::fs::read_to_string("/tmp/whitt-latest-release.txt") {
+                    let current = env!("CARGO_PKG_VERSION");
+                    let latest = latest.trim();
+                    if !latest.is_empty() && latest != current {
+                        println!("\n⚠️  whitt update available: {} → {} (run: whitt sbc update --host {})", current, latest, host);
+                    }
+                }
+            }
+            return Ok(());
+        }
+        tokio::time::sleep(std::time::Duration::from_secs(5)).await;
+    }
+}
+
+async fn sbc_update(host: &str, prerelease: bool, version: Option<&str>) -> Result<()> {
+    let gh_args = match version {
+        Some(v) => format!("--pattern whitt-aarch64-{}*", v),
+        None => {
+            if prerelease {
+                "--pattern whitt-aarch64-*".to_string()
+            } else {
+                "--exclude-drafts --exclude-pre-releases --pattern whitt-aarch64-*".to_string()
+            }
+        }
+    };
+
+    println!("==> Downloading whitt aarch64 artifact via gh release download");
+    println!(
+        "    gh release download {} {}",
+        version.unwrap_or("(latest)"),
+        gh_args
+    );
+
+    let status = std::process::Command::new("gh")
+        .args([
+            "release",
+            "download",
+            version.unwrap_or(""),
+            &gh_args,
+            "--output",
+            "/tmp/whitt-aarch64-update",
+        ])
+        .status()
+        .map_err(|e| anyhow::anyhow!("gh spawn failed: {}", e))?;
+    if !status.success() {
+        anyhow::bail!("gh release download exited {:?}", status.code());
+    }
+
+    println!(
+        "==> scp'ing new binary to {}:/usr/local/bin/whitt.new",
+        host
+    );
+    let scp_status = std::process::Command::new("scp")
+        .args([
+            "-o",
+            "ConnectTimeout=10",
+            "-o",
+            "BatchMode=yes",
+            "-o",
+            "StrictHostKeyChecking=accept-new",
+            "/tmp/whitt-aarch64-update",
+            &format!("root@{}:/usr/local/bin/whitt.new", host),
+        ])
+        .status()
+        .map_err(|e| anyhow::anyhow!("scp spawn failed: {}", e))?;
+    if !scp_status.success() {
+        anyhow::bail!("scp exited {:?}", scp_status.code());
+    }
+
+    println!("==> Swapping binary + restarting services");
+    let swap = ssh_probe(
+        host,
+        "mv /usr/local/bin/whitt.new /usr/local/bin/whitt \
+         && chmod +x /usr/local/bin/whitt \
+         && systemctl restart llama-server.service 2>/dev/null || true",
+    );
+    if let Some(s) = swap {
+        if s.contains("auth failed") || s.contains("unreachable") {
+            anyhow::bail!("ssh failed: {}", s);
+        }
+    }
+    println!("updated whitt on {}", host);
+    Ok(())
+}
+
+async fn sbc_llama_update(host: &str, tag: &str) -> Result<()> {
+    println!("==> Updating llama.cpp on {} to tag {}", host, tag);
+    let cmd = format!(
+        "sed -i -E 's|^LLAMA_TAG=.*|LLAMA_TAG={}|' /opt/whitt-neuron/build-llamacpp.sh \
+         && rm -f /usr/local/bin/llama-server \
+         && /opt/whitt-neuron/build-llamacpp.sh \
+         && systemctl restart llama-server.service",
+        tag
+    );
+    let result = ssh_probe(host, &cmd);
+    match result {
+        Some(s) if s.contains("auth failed") || s.contains("unreachable") => {
+            anyhow::bail!("ssh failed: {}", s)
+        }
+        _ => println!("llama.cpp updated to {} on {}", tag, host),
+    }
+    Ok(())
+}
+
+async fn sbc_factory_reset(host: &str, yes: bool) -> Result<()> {
+    if !yes {
+        println!(
+            "This will erase /etc/whitt-neuron/* + firstboot.done on {} and REBOOT the SBC.",
+            host
+        );
+        print!("Type 'yes' to continue: ");
+        use std::io::Write;
+        std::io::stdout().flush().ok();
+        let mut input = String::new();
+        std::io::stdin().read_line(&mut input)?;
+        if input.trim() != "yes" {
+            println!("aborted");
+            return Ok(());
+        }
+    }
+    let cmd = "rm -rf /etc/whitt-neuron/* /var/lib/whitt-neuron/firstboot.done \
+               && systemctl reboot";
+    let result = ssh_probe(host, cmd);
+    match result {
+        Some(s) if s.contains("auth failed") || s.contains("unreachable") => {
+            anyhow::bail!("ssh failed: {}", s)
+        }
+        _ => println!(
+            "factory reset complete — SBC {} rebooting. First-boot will re-run.",
+            host
+        ),
+    }
+    Ok(())
+}
+
+fn generate_completions(shell: CompletionShell) -> Result<()> {
+    #[cfg(feature = "cli-completions")]
+    {
+        use clap::CommandFactory;
+        use clap_complete::Shell;
+        let target = match shell {
+            CompletionShell::Bash => Shell::Bash,
+            CompletionShell::Zsh => Shell::Zsh,
+            CompletionShell::Fish => Shell::Fish,
+            CompletionShell::Powershell => Shell::PowerShell,
+            CompletionShell::Elvish => Shell::Elvish,
+        };
+        let mut cmd = Cli::command();
+        clap_complete::generate(target, &mut cmd, "whitt", &mut std::io::stdout());
+        Ok(())
+    }
+    #[cfg(not(feature = "cli-completions"))]
+    {
+        let _ = shell;
+        anyhow::bail!(
+            "completions require building with --features cli-completions (cargo install --path . --features cli-completions)"
+        )
+    }
+}
