+/// Embedded ARM64 SBC profile (kept in sync with `configs/profiles/a733.yml`
+/// via `include_str!`). Used by `whitt sbc install --embed-config` so the
+/// binary is self-contained and the profile never drifts from the binary
+/// version.
+const SBC_ARM64_PROFILE_YAML: &str = include_str!("../../configs/profiles/a733.yml");
+
+fn sbc_info_yaml() -> String {
+    let mut out = String::new();
+    out.push_str("target:\n");
+    out.push_str("  board: Orange Pi Zero 3W\n");
+    out.push_str("  soc: Allwinner A733\n");
+    out.push_str("  arch: aarch64\n");
+    out.push_str("  cores: 8\n");
+    out.push_str("  ram_mb: 12288\n");
+    out.push_str("  gpu: PowerVR BXM-4-64 (no Vulkan userspace on stock BSP)\n");
+    out.push_str("throughput_estimate_tok_per_s:\n");
+    out.push_str("  3B_q4_k_m: \"1-4\"\n");
+    out.push_str("  7B_9B_q4: \"0.5-1.5\"\n");
+    out.push_str("build:\n");
+    out.push_str("  host: x86_64\n");
+    out.push_str("  target: aarch64-unknown-linux-gnu\n");
+    out.push_str(
+        "  cmd: cargo build --release --target aarch64-unknown-linux-gnu --features client\n",
+    );
+    out.push_str("deploy:\n");
+    out.push_str(
+        "  cmd_1: scp target/aarch64-unknown-linux-gnu/release/whitt root@opi-zero3w.local:~/\n",
+    );
+    out.push_str(
+        "  cmd_2: ssh root@opi-zero3w.local 'bash scripts/install-opi3w.sh --binary ./whitt'\n",
+    );
+    out.push_str("profile:\n");
+    out.push_str("  path: configs/profiles/a733.yml\n");
+    out.push_str("  context_size: 8192\n");
+    out.push_str("  threads: 8\n");
+    out.push_str("  gpu_layers: 0\n");
+    out.push_str("  cache_k: q4_0\n");
+    out.push_str("  cache_v: q4_0\n");
+    out.push_str("reference_doc: docs/cli-opi3w.md\n");
+    out
+}
