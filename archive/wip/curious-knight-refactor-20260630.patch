+async fn sbc_model_pull(host: &str, repo: &str, file: Option<&str>) -> Result<()> {
+    let target_file = file
+        .map(|s| s.to_string())
+        .unwrap_or_else(|| format!("{}-Q8_0.gguf", repo.rsplit('/').next().unwrap_or(repo)));
+    println!(
+        "==> Pulling {}:{} to {}:/models/{}",
+        repo, target_file, host, target_file
+    );
+    let escaped_repo = repo.replace('\'', "'\\''");
+    let escaped_file = target_file.replace('\'', "'\\''");
+    let cmd = format!(
+        "if ! command -v huggingface-cli >/dev/null 2>&1 && ! command -v hf >/dev/null 2>&1; then \
+            apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3-pip \
+            && pip3 install --break-system-packages huggingface-hub; \
+         fi; \
+         HF_TOOL=$(command -v huggingface-cli || command -v hf); \
+         cd /models && \
+         HF_TOKEN=$(grep -E '^HF_TOKEN=' /etc/whitt-neuron/llama.env 2>/dev/null | cut -d= -f2-) \
+         $HF_TOOL download '{}' '{}' --local-dir /models/ --local-dir-use-symlinks False 2>&1 || \
+         $HF_TOOL download '{}' '{}' --local-dir /models/ 2>&1",
+        escaped_repo, escaped_file, escaped_repo, escaped_file
+    );
+    let result = ssh_probe(host, &cmd);
+    match result {
+        Some(s) if s.contains("auth failed") || s.contains("unreachable") => {
+            anyhow::bail!("ssh failed: {}", s)
+        }
+        Some(s) => println!("{}", s),
+        None => println!("(no output)"),
+    }
+    println!("done — verify with: whitt sbc model list --host {}", host);
+    Ok(())
+}
