+    /// Check if step requirements are satisfied and fire on_requires_failed hook if not.
+    /// Returns true if step should execute, false if it should be skipped.
+    fn check_and_fire_on_requires_failed(
+        &mut self,
+        step: &WorkflowStep,
+        step_outputs: &std::collections::HashMap<String, String>,
+    ) -> Result<bool> {
+        let requires = &step.requires;
+        if requires.is_empty() {
+            return Ok(true);
+        }
+
+        let missing_deps: Vec<String> = requires
+            .iter()
+            .filter(|dep| !step_outputs.contains_key(dep.as_str()))
+            .cloned()
+            .collect();
+
+        if missing_deps.is_empty() {
+            return Ok(true);
+        }
+
+        let context = WorkflowHookContext::OnRequiresFailed(OnRequiresFailedContext {
+            failed_step: step.step_id.clone(),
+            reason: format!("Missing dependencies: {:?}", missing_deps),
+            dependency_chain: requires.clone(),
+        });
+
+        match self.execute_hooks_for_trigger(&step.when, "on_requires_failed", &context) {
+            Ok(HookResult::Fail { reason }) => {
+                Err(anyhow::anyhow!(
+                    "Dependency check failed for step {}: {}",
+                    step.step_id,
+                    reason
+                ))
+            }
+            Ok(HookResult::SkipRemaining) => {
+                info!(
+                    "[benchmark] step {} and all remaining steps skipped due to failed dependencies",
+                    step.step_id
+                );
+                Ok(false)
+            }
+            Ok(HookResult::SkipStep | HookResult::SkipLoop | HookResult::Continue) => {
+                info!(
+                    "[benchmark] step {} skipped due to failed dependencies: {:?}",
+                    step.step_id, missing_deps
+                );
+                Ok(false)
+            }
+            Ok(HookResult::RouteTo { .. }) => {
+                warn!("[benchmark] RouteTo not applicable in on_requires_failed, skipping step {}", step.step_id);
+                Ok(false)
+            }
+            Err(e) => {
+                warn!(
+                    "[benchmark] on_requires_failed hook error for step {}: {}, skipping",
+                    step.step_id, e
+                );
+                Ok(false)
+            }
+        }
+    }
+
+    /// Merge workflow-level and step-level `when:` hooks.
+    ///
+    /// Step-level hooks take precedence over workflow-level hooks.
+    /// If both are objects, deep merge where step-level overrides workflow-level.
+    fn merge_when_hooks(
+        workflow_when: Option<&serde_json::Value>,
+        step_when: &Option<serde_json::Value>,
+    ) -> Option<serde_json::Value> {
+        match (workflow_when, step_when) {
+            (None, step) => step.as_ref().cloned(),
+            (Some(workflow_val), None) => Some(workflow_val.clone()),
+            (Some(workflow_val), Some(step_val)) => {
+                let workflow_obj = workflow_val.as_object();
+                let step_obj = step_val.as_object();
+
+                match (workflow_obj, step_obj) {
+                    (Some(wf), Some(st)) => {
+                        let mut merged = wf.clone();
+                        for (key, value) in st.iter() {
+                            merged.insert(key.clone(), value.clone());
+                        }
+                        Some(serde_json::Value::Object(merged))
+                    }
+                    _ => step_val.clone(),
+                }
+            }
+        }
+    }
