//! Integration tests for YAML-driven hook behavior.
//!
//! Tests verify:
//! - HookAction types deserialize from valid YAML
//! - HookEngine executes hooks with correct context
//! - GWT expressions evaluate correctly
//! - Side effects occur (logs, bookmarks, file writes)
//! - Negative cases produce appropriate errors

use std::collections::HashMap;
use std::fs;
use std::path::Path;
use tempfile::TempDir;
use serde_saphyr as serde_yaml;

use whitt_execution_engine::workflow::hooks::{
    HookEngine, HookResult, WorkflowHookContext,
    context::{self, ErrorDetails},
    gwt::evaluate,
    actions::execute_action,
};
use whitt_execution_engine::workflow::step::{HookAction, LogAction, SaveToAction, AppendToAction,
    RouteToAction, BookmarkAction, FailAction, GwtClause};
use whitt_execution_engine::workflow::schema::LogLevel;
use serde_json::json;

// ============================================================================
// HookAction Deserialization Tests
// ============================================================================

#[test]
fn given_yaml_log_action_when_deserialize_then_has_correct_structure() {
    let yaml = r#"
to_file_path: "./test.log"
event_fields: ["step_name", "output"]
level: info
    "#;

    let action: LogAction = serde_yaml::from_str(yaml)
        .expect("Should deserialize successfully");

    assert_eq!(action.to_file_path, Some("./test.log".to_string()));
    assert_eq!(action.event_fields, Some(vec!["step_name".to_string(), "output".to_string()]));
    assert_eq!(action.level, Some(LogLevel::Info));
}

#[test]
fn given_yaml_save_to_both_when_deserialize_then_has_both_targets() {
    let yaml = r#"
- variable_name
- "./output.json"
    "#;

    let action: SaveToAction = serde_yaml::from_str(yaml)
        .expect("Should deserialize successfully");

    match action {
        SaveToAction::Both(targets) => {
            assert_eq!(targets, vec!["variable_name".to_string(), "./output.json".to_string()]);
        }
        _ => panic!("Expected Both variant"),
    }
}

#[test]
fn given_yaml_gwt_clause_when_deserialize_then_has_all_fields() {
    let yaml = r#"
given: "score >= 0.9"
when: "quality check passed"
then:
  route_to: pass
    "#;

    let clause: GwtClause = serde_yaml::from_str(yaml)
        .expect("Should deserialize successfully");

    assert_eq!(clause.given, Some("score >= 0.9".to_string()));
    assert_eq!(clause.r#when, Some("quality check passed".to_string()));
}

#[test]
fn given_yaml_route_to_multiple_when_deserialize_then_has_all_targets() {
    let yaml = r#"
- next_step
- alternative_step
    "#;

    let action: RouteToAction = serde_yaml::from_str(yaml)
        .expect("Should deserialize successfully");

    match action {
        RouteToAction::Multiple(targets) => {
            assert_eq!(targets, vec!["next_step".to_string(), "alternative_step".to_string()]);
        }
        _ => panic!("Expected Multiple variant"),
    }
}

#[test]
fn given_skip_actions_fixture_when_parsed_then_skip_actions_present() {
    // GIVEN the skip-actions.yml fixture
    let fixture_path = "tests/fixtures/hooks/skip-actions.yml";

    // WHEN parsing the YAML file
    let yaml_content = fs::read_to_string(fixture_path)
        .expect("Fixture file should exist");

    // THEN skip actions are present
    assert!(yaml_content.contains("skip_step"));
    assert!(yaml_content.contains("skip_remaining"));
    assert!(yaml_content.contains("skip_loop"));
}

#[test]
fn given_gwt_expressions_fixture_when_parsed_then_complex_expressions_present() {
    // GIVEN the gwt-expressions.yml fixture
    let fixture_path = "tests/fixtures/hooks/gwt-expressions.yml";

    // WHEN parsing the YAML file
    let yaml_content = fs::read_to_string(fixture_path)
        .expect("Fixture file should exist");

    // THEN complex expressions are present
    assert!(yaml_content.contains("score >= 0.9"));
    assert!(yaml_content.contains("&&"));
    assert!(yaml_content.contains("||"));
    assert!(yaml_content.contains("!"));
    assert!(yaml_content.contains("error.is_retryable"));
}

#[test]
fn given_bookmark_notify_fixture_when_parsed_then_bookmark_and_notify_present() {
    // GIVEN the bookmark-notify.yml fixture
    let fixture_path = "tests/fixtures/hooks/bookmark-notify.yml";

    // WHEN parsing the YAML file
    let yaml_content = fs::read_to_string(fixture_path)
        .expect("Fixture file should exist");

    // THEN bookmark and notify actions are present
    assert!(yaml_content.contains("bookmark"));
    assert!(yaml_content.contains("notify"));
