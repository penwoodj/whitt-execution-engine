// ============================================================================
// End-to-End Workflow Tests
// ============================================================================

#[test]
fn given_fixture_all_triggers_when_parse_yaml_then_all_actions_extractable() {
    // GIVEN all-triggers.yml fixture
    let fixture_path = "tests/fixtures/hooks/all-triggers.yml";
    let yaml_content = fs::read_to_string(fixture_path).expect("Fixture should exist");

    // WHEN parsing steps with hooks
    let workflow: serde_yaml::Value = serde_yaml::from_str(&yaml_content)
        .expect("YAML should parse");
    let steps = workflow.get("steps").expect("Steps should exist");

    // THEN hooks are present for expected triggers
    if let Some(read_config) = steps.get("read_config") {
        let when = read_config.get("when").expect("when should exist");
        assert!(when.get("before_step_starts").is_some());
        assert!(when.get("after_step_succeeds").is_some());
        assert!(when.get("after_step_fails").is_some());
    }
}

#[test]
fn given_fixture_gwt_expressions_when_parse_then_all_expressions_extractable() {
    // GIVEN gwt-expressions.yml fixture
    let fixture_path = "tests/fixtures/hooks/gwt-expressions.yml";
    let yaml_content = fs::read_to_string(fixture_path).expect("Fixture should exist");

    // WHEN parsing GWT expressions
    let workflow: serde_yaml::Value = serde_yaml::from_str(&yaml_content)
        .expect("YAML should parse");
    let steps = workflow.get("steps").expect("Steps should exist");

    // THEN GWT expressions are present
    if let Some(gwt_test) = steps.get("gwt_decision") {
        let when = gwt_test.get("when").expect("when should exist");
        assert!(when.get("gwt").is_some());
    }
}

#[test]
fn given_fixture_skip_actions_when_parse_then_skip_actions_extractable() {
    // GIVEN skip-actions.yml fixture
    let fixture_path = "tests/fixtures/hooks/skip-actions.yml";
    let yaml_content = fs::read_to_string(fixture_path).expect("Fixture should exist");

    // WHEN parsing skip actions
    let workflow: serde_yaml::Value = serde_yaml::from_str(&yaml_content)
        .expect("YAML should parse");
    let steps = workflow.get("steps").expect("Steps should exist");

    // THEN skip actions are present
    if let Some(skip_step) = steps.get("step_with_skip_step") {
        let when = skip_step.get("when").expect("when should exist");
        assert!(when.get("after_step_starts").is_some());
    }
}

#[test]
fn given_workflow_with_log_hook_when_execute_then_log_file_created() {
    // GIVEN a workflow with log hook
    let temp_dir = TempDir::new().unwrap();
    let log_path = temp_dir.path().join("workflow.log").to_string_lossy().to_string();
    let action = HookAction::Log(LogAction {
        to_file_path: Some(log_path.clone()),
        event_fields: None,
        level: Some(LogLevel::Info),
    });
    let context = WorkflowHookContext::AfterStepSucceeds(AfterStepSucceedsContext {
        step_name: "workflow_step".to_string(),
        output: "Step completed".to_string(),
        duration_ms: 500,
        quality_score: None,
        token_count: 100,
        model_name: "model".to_string(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the log hook
    execute_action(&action, &context, &mut engine);

    // THEN log file is created with expected content
    assert!(Path::new(&log_path).exists());
    let content = fs::read_to_string(&log_path).unwrap();
    assert!(content.contains("workflow_step"));
}

#[test]
fn given_workflow_with_bookmark_hook_when_execute_then_checkpoint_stored() {
    // GIVEN a workflow with bookmark hook
    let temp_dir = TempDir::new().unwrap();
    let checkpoint_path = temp_dir.path().join("checkpoint.cp").to_string_lossy().to_string();
    let action = HookAction::Bookmark(BookmarkAction {
        path: Some(checkpoint_path.clone()),
    });
    let context = WorkflowHookContext::AfterStepSucceeds(AfterStepSucceedsContext {
        step_name: "critical_step".to_string(),
        output: "{\"data\":\"checkpointed\"}".to_string(),
        duration_ms: 1000,
        quality_score: Some(0.95),
        token_count: 500,
        model_name: "model".to_string(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the bookmark hook
    execute_action(&action, &context, &mut engine);

    // THEN checkpoint is stored in engine and file
    let bookmark = engine.get_bookmark("critical_step");
    assert!(bookmark.is_some());
    assert_eq!(bookmark.unwrap().get("data").and_then(|v| v.as_str()), Some("checkpointed"));
    assert!(Path::new(&checkpoint_path).exists());
}

// ============================================================================
// GWT Expression Tests
// ============================================================================

#[test]
fn given_fixture_gwt_comparison_when_evaluate_then_correct_result() {
    // GIVEN context from fixture
    let context = json!({
        "score": 0.95
    });

    // WHEN evaluating comparison expression from fixture
    let result = evaluate("score >= 0.9", &context)
        .expect("Evaluation should succeed");

    // THEN result is true
    assert!(result);
}

#[test]
fn given_fixture_gwt_logical_when_evaluate_then_correct_result() {
    // GIVEN context from fixture
    let context = json!({
        "is_valid": true,
        "has_warnings": false
    });

    // WHEN evaluating logical expression from fixture
    let result = evaluate("is_valid == true && has_warnings == false", &context)
        .expect("Evaluation should succeed");

    // THEN result is true
    assert!(result);
}

#[test]
fn given_fixture_gwt_nested_field_when_evaluate_then_correct_result() {
    // GIVEN context from fixture
    let context = json!({
        "error": {
            "is_retryable": true,
            "code": 503
        }
    });

    // WHEN evaluating nested field expression from fixture
    let result = evaluate("error.is_retryable == true && error.code != 500", &context)
        .expect("Evaluation should succeed");

    // THEN result is true
    assert!(result);
}

#[test]
fn given_fixture_gwt_arithmetic_when_evaluate_then_correct_result() {
    // GIVEN context from fixture
    let context = json!({
        "token_count": 500,
        "total": 250,
        "count": 500
    });

    // WHEN evaluating arithmetic expression from fixture
    let result1 = evaluate("token_count * 2 > 1000", &context)
        .expect("Evaluation should succeed");
    let result2 = evaluate("total / count >= 0.5", &context)
        .expect("Evaluation should succeed");

    // THEN results are correct
    assert!(result1);
    assert!(result2);
}

#[test]
fn given_fixture_gwt_string_when_evaluate_then_correct_result() {
    // GIVEN context from fixture
    let context = json!({
        "status": "completed"
    });

    // WHEN evaluating string expression from fixture
    let result = evaluate("status == \"completed\"", &context)
        .expect("Evaluation should succeed");

    // THEN result is true
    assert!(result);
}

#[test]
fn given_gwt_clause_matching_when_execute_action_then_routes_to_target() {
    // GIVEN a GWT clause and matching context
    let clauses = vec![GwtClause {
        given: Some("score >= 0.9".to_string()),
        r#when: None,
        r#then: RouteToAction::Single("pass".to_string()),
    }];
    let context = WorkflowHookContext::AfterStepSucceeds(AfterStepSucceedsContext {
        step_name: "test".to_string(),
        output: "Done".to_string(),
        duration_ms: 100,
        quality_score: Some(0.95),
        token_count: 10,
        model_name: "model".to_string(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the GWT clause
    let result = execute_action(&HookAction::Gwt(clauses), &context, &mut engine);

    // THEN routes to target
    match result {
        HookResult::RouteTo { targets } => {
            assert_eq!(targets, vec!["pass"]);
        }
        _ => panic!("Expected RouteTo result"),
    }
}

#[test]
fn given_gwt_clause_not_matching_when_execute_action_then_continues() {
    // GIVEN a GWT clause and non-matching context
    let clauses = vec![GwtClause {
        given: Some("score >= 0.9".to_string()),
        r#when: None,
        r#then: RouteToAction::Single("pass".to_string()),
    }];
    let context = WorkflowHookContext::AfterStepSucceeds(AfterStepSucceedsContext {
        step_name: "test".to_string(),
        output: "Done".to_string(),
        duration_ms: 100,
        quality_score: Some(0.85),
        token_count: 10,
        model_name: "model".to_string(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the GWT clause
    let result = execute_action(&HookAction::Gwt(clauses), &context, &mut engine);

    // THEN continues normally
    assert_eq!(result, HookResult::Continue);
}

#[test]
fn given_gwt_multiple_clauses_when_execute_action_then_first_matching_wins() {
    // GIVEN multiple GWT clauses
    let clauses = vec![
        GwtClause {
            given: Some("score >= 0.9".to_string()),
            r#when: None,
            r#then: RouteToAction::Single("excellent".to_string()),
        },
        GwtClause {
            given: Some("score >= 0.7".to_string()),
            r#when: None,
            r#then: RouteToAction::Single("good".to_string()),
        },
        GwtClause {
            given: Some("true".to_string()),
            r#when: None,
            r#then: RouteToAction::Single("fallback".to_string()),
        },
    ];
    let context = WorkflowHookContext::AfterStepSucceeds(AfterStepSucceedsContext {
        step_name: "test".to_string(),
        output: "Done".to_string(),
        duration_ms: 100,
        quality_score: Some(0.95),
        token_count: 10,
        model_name: "model".to_string(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the GWT clauses
    let result = execute_action(&HookAction::Gwt(clauses), &context, &mut engine);

    // THEN first matching clause wins
    match result {
        HookResult::RouteTo { targets } => {
            assert_eq!(targets, vec!["excellent"]);
        }
        _ => panic!("Expected RouteTo result"),
    }
}

// ============================================================================
// Negative Tests
// ============================================================================

#[test]
fn given_empty_log_action_when_deserialize_then_fails_validation() {
    // GIVEN an empty log action (invalid per fixture)
    let yaml = r#"
    log:
      to_file_path: ""
      event_fields: []
    "#;

    // WHEN deserializing
    // THEN it deserializes but represents invalid configuration
    let action: LogAction = serde_yaml::from_str(yaml)
        .expect("Deserialization succeeds but represents invalid config");
    assert_eq!(action.to_file_path, Some("".to_string()));
}

#[test]
fn given_gwt_invalid_syntax_when_evaluate_then_returns_error() {
    // GIVEN an invalid GWT expression (per fixture)
    let context = json!({});
    let expr = "!!! invalid syntax !!!";

    // WHEN evaluating
    let result = evaluate(expr, &context);

    // THEN evaluation fails
    assert!(result.is_err());
}

#[test]
fn given_gwt_missing_field_when_evaluate_then_returns_false() {
    // GIVEN a context without the referenced field
    let context = json!({
        "existing_field": "value"
    });

    // WHEN evaluating expression with missing field
    let result = evaluate("missing_field == \"test\"", &context)
        .expect("Evaluation should succeed");

    // THEN returns false (missing fields treated as null/false)
    assert!(!result);
}

#[test]
fn given_hook_action_unknown_when_deserialize_then_fails() {
    // GIVEN an unknown action type (per fixture)
    let yaml = r#"
    completely_unknown_action: "this should fail"
    "#;

    // WHEN deserializing
    let result: Result<HookAction, _> = serde_yaml::from_str(yaml);

    // THEN deserialization fails
    assert!(result.is_err());
}

#[test]
fn given_empty_fail_action_when_execute_then_fails_with_default_message() {
    // GIVEN a fail action with empty message (per fixture)
    let action = FailAction {
        message: Some("".to_string()),
    };
    let context = WorkflowHookContext::BeforeStepStarts(BeforeStepStartsContext {
        step_name: "test".to_string(),
        step_type: StepType::Generative,
        model_name: "model".to_string(),
        prompt_preview: "prompt".to_string(),
        workflow_variables: HashMap::new(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the fail action
    let result = execute_action(&HookAction::Fail(action), &context, &mut engine);

    // THEN result is Fail with empty message
    match result {
        HookResult::Fail { reason } => {
            assert_eq!(reason, "");
        }
        _ => panic!("Expected Fail result"),
    }
}