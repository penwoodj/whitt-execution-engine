}

#[test]
fn given_negative_invalid_fixture_when_parsed_then_contains_invalid_configurations() {
    // GIVEN the negative-invalid.yml fixture
    let fixture_path = "tests/fixtures/hooks/negative-invalid.yml";

    // WHEN parsing the YAML file
    let yaml_content = fs::read_to_string(fixture_path)
        .expect("Fixture file should exist");

    // THEN invalid configurations are marked
    assert!(yaml_content.contains("NOTE: This file intentionally contains INVALID"));
    assert!(yaml_content.contains("empty_log"));
    assert!(yaml_content.contains("invalid_gwt"));
    assert!(yaml_content.contains("invalid_route"));
    assert!(yaml_content.contains("unknown_action"));
}

#[test]
fn given_hook_action_log_when_deserialized_from_yaml_then_has_correct_structure() {
    // GIVEN a log action in YAML format
    let yaml = r#"
    log:
      to_file_path: "./test.log"
      event_fields: ["step_name", "output"]
      level: info
    "#;

    // WHEN deserializing to HookAction
    let action: HookAction = serde_yaml::from_str(yaml)
        .expect("Should deserialize successfully");

    // THEN the action has correct structure
    match action {
        HookAction::Log(log_action) => {
            assert_eq!(log_action.to_file_path, Some("./test.log".to_string()));
            assert_eq!(log_action.event_fields, Some(vec!["step_name".to_string(), "output".to_string()]));
            assert_eq!(log_action.level, Some(LogLevel::Info));
        }
        _ => panic!("Expected Log action"),
    }
}

#[test]
fn given_hook_action_save_to_when_deserialized_from_yaml_then_has_correct_structure() {
    // GIVEN a save_to action in YAML format
    let yaml = r#"
    - variable_name
    - "./output.json"
    "#;

    // WHEN deserializing to SaveToAction
    let action: SaveToAction = serde_yaml::from_str(yaml)
        .expect("Should deserialize successfully");

    // THEN the action has correct structure
    match action {
        SaveToAction::Both(targets) => {
            assert_eq!(targets, vec!["variable_name".to_string(), "./output.json".to_string()]);
        }
        _ => panic!("Expected Both variant"),
    }
}

#[test]
fn given_hook_action_gwt_when_deserialized_from_yaml_then_has_correct_structure() {
    // GIVEN a GWT clause in YAML format
    let yaml = r#"
    - given: "score >= 0.9"
      when: "quality check passed"
      then: { route_to: pass }
    "#;

    // WHEN deserializing to Vec<GwtClause>
    let clauses: Vec<GwtClause> = serde_yaml::from_str(yaml)
        .expect("Should deserialize successfully");

    // THEN the clause has correct structure
    assert_eq!(clauses.len(), 1);
    assert_eq!(clauses[0].given, Some("score >= 0.9".to_string()));
    assert_eq!(clauses[0].r#when, Some("quality check passed".to_string()));
}

#[test]
fn given_hook_action_route_to_when_deserialized_from_yaml_then_has_correct_structure() {
    // GIVEN a route_to action in YAML format
    let yaml = r#"
    - next_step
    - alternative_step
    "#;

    // WHEN deserializing to RouteToAction
    let action: RouteToAction = serde_yaml::from_str(yaml)
        .expect("Should deserialize successfully");

    // THEN the action has correct structure
    match action {
        RouteToAction::Multiple(targets) => {
            assert_eq!(targets, vec!["next_step".to_string(), "alternative_step".to_string()]);
        }
        _ => panic!("Expected Multiple variant"),
    }
}

#[test]
fn given_multiple_actions_in_when_when_deserialized_from_yaml_then_has_all_actions() {
    // GIVEN multiple actions in YAML format
    let yaml = r#"
    - log:
        to_file_path: "./test.log"
        level: info
    - save_to:
        - result
        - "./output.json"
    "#;

    // WHEN deserializing to Vec<HookAction>
    let actions: Vec<HookAction> = serde_yaml::from_str(yaml)
        .expect("Should deserialize successfully");

    // THEN all actions are present
    assert_eq!(actions.len(), 2);
    assert!(matches!(actions[0], HookAction::Log(_)));
    assert!(matches!(actions[1], HookAction::SaveTo(_)));
}

// ============================================================================
// HookEngine Integration Tests
// ============================================================================

#[test]
fn given_hook_engine_new_when_created_then_has_empty_bookmarks() {
    // GIVEN a new HookEngine
    let engine = HookEngine::new();

    // THEN bookmarks are empty
    assert!(engine.bookmarks.is_empty());
    assert!(engine.notify_tx.is_none());
}

#[test]
fn given_hook_engine_when_store_bookmark_then_retrievable() {
    // GIVEN a HookEngine
    let mut engine = HookEngine::new();

    // WHEN storing a bookmark
    let value = json!({"status": "done", "data": "test"});
    engine.store_bookmark("test_bookmark".to_string(), value.clone());

    // THEN bookmark is retrievable
    let retrieved = engine.get_bookmark("test_bookmark");
    assert_eq!(retrieved, Some(&value));
}

#[test]
fn given_log_action_with_file_path_when_execute_then_file_created() {
    // GIVEN a log action and temp directory
    let temp_dir = TempDir::new().unwrap();
    let log_path = temp_dir.path().join("test.log").to_string_lossy().to_string();
    let action = LogAction {
        to_file_path: Some(log_path.clone()),
        event_fields: Some(vec!["step_name".to_string()]),
        level: Some(LogLevel::Info),
    };
    let context = WorkflowHookContext::BeforeStepStarts(BeforeStepStartsContext {
        step_name: "test_step".to_string(),
        step_type: StepType::Generative,
        model_name: "model".to_string(),
        prompt_preview: "prompt".to_string(),
        workflow_variables: HashMap::new(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the log action
    let result = execute_action(&HookAction::Log(action), &context, &mut engine);

    // THEN file is created and result is Continue
    assert_eq!(result, HookResult::Continue);
    assert!(Path::new(&log_path).exists());
    let content = fs::read_to_string(&log_path).unwrap();
    assert!(content.contains("test_step"));
}

#[test]
fn given_log_action_without_file_path_when_execute_then_returns_continue() {
    // GIVEN a log action without file path
    let action = LogAction::default();
    let context = WorkflowHookContext::BeforeStepStarts(BeforeStepStartsContext {
        step_name: "test".to_string(),
        step_type: StepType::Generative,
        model_name: "model".to_string(),
        prompt_preview: "prompt".to_string(),
        workflow_variables: HashMap::new(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the log action
    let result = execute_action(&HookAction::Log(action), &context, &mut engine);

    // THEN result is Continue
    assert_eq!(result, HookResult::Continue);
}

#[test]
fn given_save_to_file_when_execute_then_file_created() {
    // GIVEN a save_to action and temp directory
    let temp_dir = TempDir::new().unwrap();
    let file_path = temp_dir.path().join("output.json").to_string_lossy().to_string();
    let action = SaveToAction::FilePath(file_path.clone());
    let context = WorkflowHookContext::AfterStepSucceeds(AfterStepSucceedsContext {
        step_name: "test".to_string(),
        output: "{\"key\":\"value\"}".to_string(),
        duration_ms: 100,
        quality_score: None,
        token_count: 10,
        model_name: "model".to_string(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the save_to action
    let result = execute_action(&HookAction::SaveTo(action), &context, &mut engine);

    // THEN file is created with content
    assert_eq!(result, HookResult::Continue);
    assert!(Path::new(&file_path).exists());
    let content = fs::read_to_string(&file_path).unwrap();
    assert!(content.contains("\"key\""));
}

#[test]
fn given_save_to_variable_when_execute_then_stored_in_bookmarks() {
    // GIVEN a save_to action targeting a variable
    let action = SaveToAction::Variable("checkpoint".to_string());
    let context = WorkflowHookContext::AfterStepSucceeds(AfterStepSucceedsContext {
        step_name: "test_step".to_string(),
        output: "{\"status\":\"done\"}".to_string(),
        duration_ms: 100,
        quality_score: None,
        token_count: 10,
        model_name: "model".to_string(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the save_to action
    let result = execute_action(&HookAction::SaveTo(action), &context, &mut engine);

    // THEN bookmark is stored
    assert_eq!(result, HookResult::Continue);
    let bookmark = engine.get_bookmark("checkpoint");
    assert!(bookmark.is_some());
    assert_eq!(bookmark.unwrap().get("status").and_then(|v| v.as_str()), Some("done"));
}

#[test]
fn given_append_to_file_when_execute_then_content_appended() {
    // GIVEN an append_to action and temp directory
    let temp_dir = TempDir::new().unwrap();
    let file_path = temp_dir.path().join("output.txt").to_string_lossy().to_string();
    let action = AppendToAction::FilePath(file_path.clone());
    let context = WorkflowHookContext::AfterStepSucceeds(AfterStepSucceedsContext {
        step_name: "test".to_string(),
        output: "line 1".to_string(),
        duration_ms: 100,
        quality_score: None,
        token_count: 10,
        model_name: "model".to_string(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing append_to twice
    execute_action(&HookAction::AppendTo(action.clone()), &context, &mut engine);
    execute_action(&HookAction::AppendTo(action), &context, &mut engine);

    // THEN content is appended twice
    let content = fs::read_to_string(&file_path).unwrap();
    assert!(content.contains("line 1"));
    let line_count = content.lines().count();
    assert!(line_count >= 2);
}

#[test]
fn given_bookmark_with_path_when_execute_then_checkpoint_file_created() {
    // GIVEN a bookmark action and temp directory
    let temp_dir = TempDir::new().unwrap();
    let bookmark_path = temp_dir.path().join("checkpoint.json").to_string_lossy().to_string();
    let action = BookmarkAction {
        path: Some(bookmark_path.clone()),
    };
    let context = WorkflowHookContext::AfterStepSucceeds(AfterStepSucceedsContext {
        step_name: "test_step".to_string(),
        output: "{\"checkpoint\":true}".to_string(),
        duration_ms: 100,
        quality_score: None,
        token_count: 10,
        model_name: "model".to_string(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the bookmark action
    let result = execute_action(&HookAction::Bookmark(action), &context, &mut engine);

    // THEN checkpoint file is created and bookmark stored
    assert_eq!(result, HookResult::Continue);
    assert!(Path::new(&bookmark_path).exists());
    let bookmark = engine.get_bookmark("test_step");
    assert!(bookmark.is_some());
}

#[test]
fn given_route_to_single_when_execute_then_returns_route_to() {
    // GIVEN a route_to action
    let action = RouteToAction::Single("next_step".to_string());
    let context = WorkflowHookContext::BeforeStepStarts(BeforeStepStartsContext {
        step_name: "test".to_string(),
        step_type: StepType::Generative,
        model_name: "model".to_string(),
        prompt_preview: "prompt".to_string(),
        workflow_variables: HashMap::new(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the route_to action
    let result = execute_action(&HookAction::RouteTo(action), &context, &mut engine);

    // THEN result is RouteTo with correct target
    match result {
        HookResult::RouteTo { targets } => {
            assert_eq!(targets, vec!["next_step"]);
        }
        _ => panic!("Expected RouteTo result"),
    }
}

#[test]
fn given_fail_action_when_execute_then_returns_fail() {
    // GIVEN a fail action
    let action = FailAction {
        message: Some("Critical error".to_string()),
    };
    let context = WorkflowHookContext::BeforeStepStarts(BeforeStepStartsContext {
        step_name: "test".to_string(),
        step_type: StepType::Generative,
        model_name: "model".to_string(),
        prompt_preview: "prompt".to_string(),
        workflow_variables: HashMap::new(),
    });
    let mut engine = HookEngine::new();

    // WHEN executing the fail action
    let result = execute_action(&HookAction::Fail(action), &context, &mut engine);

    // THEN result is Fail with reason
    match result {
        HookResult::Fail { reason } => {
            assert_eq!(reason, "Critical error");
        }
        _ => panic!("Expected Fail result"),
    }
}

