  "auth": {
    "token_endpoint": "/oauth/token",
    "grant_type": "client_credentials",
    "token_lifetime_seconds": 3600,
    "refresh_constraint": "only one in-flight refresh is permitted per process"
  },
  "error_codes": {
    "retryable": [
      "rate_limited",
      "internal_error"
    ],
    "terminal": [
      "invalid_request",
      "authentication_failed",
      "card_declined",
      "insufficient_funds",
      "idempotency_conflict",
      "not_found"
    ],
    "retry_policy": {
      "retryable": {
        "base_delay_ms": 250,
        "max_attempts": 4,
        "exponential_backoff": true,
        "jitter": true,
        "respect_retry_after_header": true
      },
      "terminal": {
        "attempts": 0,
        "immediate_raise": true
      }
    },
    "authentication_failed": {
      "tier": "terminal",
      "retry_policy": {
        "attempts": 1,
        "action": "refresh_token_and_reattempt"
      }
    },
    "idempotency_conflict": {
      "tier": "terminal",
      "description": "A replay with the same idempotency_key and different request body is detected; this error must be surfaced as a distinct exception type to prevent corrupted refund accounting."
    }
  },
  "rate_limits": {
    "write_ceiling_per_minute": 100,
    "read_ceiling_per_minute": 1000,
    "headers": [
      "X-RateLimit-Remaining",
      "X-RateLimit-Reset"
    ],
    "metric_template": "ledgerbridge.{operation}.{outcome}",
    "outcomes": {
      "ok": "successful operation",
      "retryable_error": "operation failed due to rate limit or internal error, retryable",
      "terminal_error": "operation failed with terminal error (e.g. invalid request, not found)"
    }
  },
