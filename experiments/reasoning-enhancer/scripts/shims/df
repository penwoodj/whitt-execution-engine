#!/usr/bin/env bash
# OBSOLETE (2026-08-24): engine preflight now honors TMPDIR (runner.rs
# tmp_root(), Issue C in docs/qa/engine-bugs/QA-FINDINGS.md). Point TMPDIR at
# the workspace instead of using this shim. Kept for reproducibility of
# historical runs (run-overcontext.py still injects it via PATH).
#
# whitt preflight runs `df -B1 /tmp` and requires >=1GB free. /tmp is a
# tmpfs saturated by foreign live whisper_stream sessions (cannot be
# freed); this experiment writes NOTHING to /tmp (all outputs go to the
# workspace on a 77GB-free fs). Shim reports 4GB avail for the exact
# preflight probe only; every other df call execs the real binary.
REAL=/usr/bin/df
if [ "$#" -eq 2 ] && [ "$1" = "-B1" ] && [ "$2" = "/tmp" ]; then
    printf 'Filesystem 1B-blocks Used Avail Capacity Mounted on\nshm 8589934592 4294967296 4294967296 50%% /tmp\n'
    exit 0
fi
exec "$REAL" "$@"
