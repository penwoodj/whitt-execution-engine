## 20. Complete YAML Example: Local Model Benchmarking Workflow

**Note**: This is a hypothetical example demonstrating how all current requirements come together.

**See full example**: `opencode/examples/benchmark_workflow.yaml`

```yaml
# CLI Configuration
cli_args:
  models:
    short: "m"
    long: "List of model names"
    description: "Models to benchmark"
    default: ["llama3.2:7b"]
  auto_install:
    short: "a"
    long: "Install missing models"
    default: true
    description: "Auto-install missing models via provider CLI"
  
  domain:
    short: "d"
    long: "Benchmarking domain (code-gen, reasoning, general, web)"
    description: "Domain for benchmarking"
    required: true
    default: "general"
  
  prompts_dir:
    description: "Directory containing prompt templates"
    required: false
    default: "./prompts/"
  
  iterations:
    short: "i"
    long: "Refinement iterations"
    default: 3
    description: "Number of refinement iterations"
    required: false

# Model Management
model_management:
  auto_install: "{{ cli_args.auto_install }}"
  provider: "ollama"
  install_command: "ollama pull {{ model_name }}"
  verify_command: "ollama list | grep {{ model_name }}"
  timeout: 300s
  on_failure: "skip"

# Agents
agents:
  - name: "benchmark_agent"
    description: "Agent for benchmarking local model performance"
    llm:
      provider: "ollama"
      model: "{{ model_name }}"
      base_url: "http://localhost:11434"
    tools:
      - file-read
      - file-write
      - memory-save
      - memory-load
    permissions:
      agent: "all"

# Workflow
workflow:
  # Run across all models in parallel
  - model_sweep: Initial code generation
    models: "{{ cli_args.models }}"
    parallel: true
    workflow:
      # Step 1: Initial code generation
      - step: "Initial task"
        agent: "benchmark_agent"
        llm:
          model: "{{ model_name }}"
        input:
          prompt: "{{ prompts.code_gen_task }}"
          output_file: "./benchmark_results/{{ model_name }}/initial_output.txt"
          domain: "{{ cli_args.domain }}"
        timeout: 60s
        metrics:
          syntax_correctness: true
          functional_correctness: true
          style_consistency: true
          domain_score: true
      
      # Step 2: Refinement loop (3 iterations)
      - loop: "Refinement loop"
        type: "refine"
        iterations: "{{ cli_args.iterations }}"
        termination:
          convergence_threshold: 0.05
          timeout: 10m
        
        tasks:
          - name: "Load previous output"
            input:
              file: "./benchmark_results/{{ model_name }}/initial_output.txt"
              tool: "file-read"
              save_to: "previous_output"
          
          - name: "Generate refinement prompt"
            input:
              template: "{{ prompts.code_refine_prompt }}"
              variables:
                previous_output: "{{ previous_output }}"
                domain: "{{ cli_args.domain }}"
              save_to: "refinement_prompt"
          
          - name: "Execute refinement"
            input:
              prompt: "{{ refinement_prompt }}"
              output_file: "./benchmark_results/{{ model_name }}/refined_output_{{ iteration }}.txt"
              tool: "file-write"
          
          - name: "Validate refinement"
            type: "validation"
            input:
              compare:
                - "./benchmark_results/{{ model_name }}/refined_output_{{ iteration }}.txt"
                - "./benchmark_results/{{ model_name }}/refined_output_{{ iteration }}.txt"
              metrics:
                - "token_diff"
                - "structure_similarity"
                - "code_quality_score"
