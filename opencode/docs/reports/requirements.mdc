## 11. YAML Schema Specification (Draft)

### Agent Definition
```yaml
agents:
  - name: <agent-name>
    description: <human-readable description>
    llm:
      provider: "lmstudio" | "ollama" | "llamacpp"
      base_url: <http-url>  # For lmstudio
      model_path: <path>     # For llamacpp
      model: <model-name>
      backend: "vulkan" | "cuda" | "metal"
      n_gpu_layers: <int>
    tools:
      - file-read
      - file-write
      - file-search
      - file-move
      - file-delete
      - grep
      - web-fetch
      - web-scrape
      - web-search
      - shell-exec
      - shell-safe
      - memory-save
      - memory-load
      - log-write
```

### Workflow Definition
```yaml
workflow:
  - step: <human-readable step name>
    agent: <agent-name>
    parallel: true | false
    permissions:
      agent: "all" | "read-only" | "custom"
      tools: ["file-read", "web-fetch"]  # Optional: limit tools
    input:
      <step-specific-input>
    output:
      <step-specific-output>
    timeout: 30s  # Operation timeout

  - loop: <loop-name>
    type: "count" | "time" | "validation" | "convergence"
    iterations: 10  # For count-based
    duration: "5m"  # For time-based
    validation: <validation-criteria>  # For validation-based
    convergence_threshold: 0.01  # For convergence-based
    termination:
      success: <success-condition>
      failure: <error-pattern>
      timeout: "10m"
    steps:
      - <nested-steps>

  - multi_agent: <task-name>
    spawn: 3  # Number of agents
    agent: <agent-name>
    aggregate: "merge" | "vote" | "collect" | "average"
    tasks:
      - name: <subtask>
        agent: <agent-name>
        input: <subtask-input>
```

### Example: Full Workflow
```yaml
agents:
  - name: file-analyzer
    description: Analyzes code and finds patterns
    llm:
      provider: "lmstudio"
      base_url: "http://localhost:1234/v1"
      model: "openai/gpt-oss-20b"
      backend: "vulkan"
    tools:
      - file-read
      - file-search
      - grep
      - memory-save

  - name: web-researcher
    description: Researches documentation and web content
    llm:
      provider: "lmstudio"
      base_url: "http://localhost:1234/v1"
      model: "openai/gpt-oss-20b"
    tools:
      - web-fetch
      - web-scrape
      - web-search
      - memory-save

  - name: code-reviewer
    description: Reviews code for issues and security
    llm:
      provider: "ollama"
      model: "llama3.2:7b"
    tools:
      - file-read
      - grep
      - log-write

workflow:
  - step: Initial codebase analysis
    agent: file-analyzer
    timeout: 60s
    permissions:
      tools: ["file-read", "file-search", "grep"]
    input:
      path: "./src/"
      patterns:
        - "async fn"
        - "unsafe"
        - "panic!"

  - loop: Iterative improvement
    type: "validation"
    validation:
      quality_score: ">= 85"
      no_critical_bugs: true
    termination:
      success: "All quality criteria met"
      failure: "No improvement in 3 iterations"
      timeout: "15m"
    steps:
      - step: Review findings
        agent: code-reviewer
        timeout: 30s
        permissions:
          agent: "read-only"
        input:
          source: "file-analyzer"

      - step: Apply improvements
        agent: file-analyzer
        timeout: 45s
        permissions:
          tools: ["file-read", "file-write"]
        input:
          recommendations: "code-reviewer"

      - step: Validate improvements
        agent: file-analyzer
        timeout: 30s
        permissions:
          agent: "read-only"
        input:
          recheck: true

  - multi_agent: Parallel codebase audit
    spawn: 3
    agent: code-reviewer
    aggregate: "merge"  # Combine all results
    tasks:
      - name: Security audit
        permissions:
          tools: ["grep"]
        input:
          pattern: "unsafe|transmute|::std::mem::"
      - name: Performance audit
        permissions:
          tools: ["grep"]
        input:
          pattern: "clone|alloc|O\\(n\\)"
      - name: Documentation audit
        permissions:
          tools: ["file-read"]
        input:
          check_complete: true

  - step: Generate final report
    agent: file-analyzer
    timeout: 60s
    permissions:
      agent: "all"
    input:
      template: final-report.md.j2
      output: ./audit-report.md
      include:
        - security_audit
        - performance_audit
        - documentation_audit
        - improvement_iterations
```

